# ============================================================
# 构建产物目录
# ============================================================
# CMake + Ninja 构建输出（CMakePresets.json 中 binaryDir 指向此处）
build/
build-*/
# 打包脚本 scripts/build_windows.ps1 的输出（windeployqt 部署 + Inno Setup 安装包）
dist/
# Inno Setup 编译产物
*.iss.bak

# 构建脚本自动下载的 Inno Setup 中文语言包
packaging/Languages/

# ============================================================
# CMake
# ============================================================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Testing/
# CMake 用户本地预设（保留 CMakePresets.json，忽略个人覆盖文件）
CMakeUserPresets.json

# ============================================================
# Ninja / Make
# ============================================================
.ninja_deps
.ninja_log
build.ninja
rules.ninja
Makefile

